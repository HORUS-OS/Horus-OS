[Unit]
Description=Firma Radicale SSH-Tunnel (PC -> VPS localhost:5232, kein offener Port)
After=network-online.target
Wants=network-online.target

[Service]
# Neue Dateien nur fuer den Eigentuemer lesbar. Ohne das entstehen session.json
# (mit Matrix-Zugangstoken) und das Ledger mit 0664 -- ein chmod im Nachhinein
# haelt nicht, weil die naechste Datei wieder offen angelegt wird.
UMask=0077
ExecStart=/usr/bin/ssh -N -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -L 5232:127.0.0.1:5232 mein-server
Restart=always
RestartSec=10

[Install]
WantedBy=default.target

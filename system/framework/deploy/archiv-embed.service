[Unit]
# Archiv' Embedding-/Such-Dienst (jina-clip-v2 CPU -> Qdrant media_jina1024).
# Braucht den Qdrant-Tunnel zum VPS.
Description=KI-Firma Archiv-Embed (Archiv Gedächtnis)
After=network-online.target horus-qdrant-tunnel.service
Wants=network-online.target

[Service]
# Neue Dateien nur fuer den Eigentuemer lesbar. Ohne das entstehen session.json
# (mit Matrix-Zugangstoken) und das Ledger mit 0664 -- ein chmod im Nachhinein
# haelt nicht, weil die naechste Datei wieder offen angelegt wird.
UMask=0077
Type=simple
ExecStart=%h/.horus-vectorizer/venv/bin/python %h/Horus-OS/system/mitarbeiter/dienste/archiv-embed/embed_search.py
Restart=on-failure
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=CUDA_VISIBLE_DEVICES=

[Install]
WantedBy=default.target

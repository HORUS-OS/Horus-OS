[Unit]
# Horcht auf firma_stand und holt bei einem Weckruf den Git-Stand.
# Läuft auf JEDEM Knoten, der Code der Firma trägt. Aktivieren:
#   systemctl --user enable --now firma-standverteiler
#
# FIRMA_KNOTEN muss zum Namen in framework/hosts.json passen — sonst meldet
# der Knoten unter seinem Hostnamen und taucht in der Übersicht doppelt auf.
Description=KI-Firma Standverteiler (Git-Abgleich per NOTIFY)
After=network-online.target
Wants=network-online.target

[Service]
# Neue Dateien nur fuer den Eigentuemer lesbar. Ohne das entstehen session.json
# (mit Matrix-Zugangstoken) und das Ledger mit 0664 -- ein chmod im Nachhinein
# haelt nicht, weil die naechste Datei wieder offen angelegt wird.
UMask=0077
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=FIRMA_KNOTEN=haupt-pc
ExecStart=%h/Horus-OS/system/mitarbeiter/framework/venv/bin/python %h/Horus-OS/system/mitarbeiter/framework/standverteiler.py
# Der Dienst hängt die meiste Zeit blockierend in LISTEN. Bricht die
# Verbindung weg, fängt er das selbst ab (30 s, neuer Versuch) — Restart ist
# nur das Netz darunter, für den Fall, dass der Prozess ganz stirbt.
Restart=always
RestartSec=15

[Install]
WantedBy=default.target

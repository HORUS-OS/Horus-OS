[Unit]
# Läuft auf dem Haupt-PC (GPU-Host). Aktivieren:
#   systemctl --user enable --now buchhalter-broker
Description=KI-Firma Buchhalter-Broker (GPU-Tor + Budget)
After=network-online.target
Wants=network-online.target

[Service]
# Neue Dateien nur fuer den Eigentuemer lesbar. Ohne das entstehen session.json
# (mit Matrix-Zugangstoken) und das Ledger mit 0664 -- ein chmod im Nachhinein
# haelt nicht, weil die naechste Datei wieder offen angelegt wird.
UMask=0077
Type=simple
ExecStart=%h/Horus-OS/system/mitarbeiter/framework/venv/bin/python %h/Horus-OS/system/mitarbeiter/buchhalter/broker/broker.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
